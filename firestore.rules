rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['active', 'email'])
        && request.resource.data.active == true
        && request.resource.data.email is string;
      allow delete: if admin() && uid != request.auth.uid;
    }
    match /users/{uid} {
      allow read: if admin();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }
    match /shops/{store}/{date}/data {
      allow read, delete: if admin();
      // Staff retain the existing ability to submit/replace daily store sales.
      allow create, update: if signedIn()
        && store in ['The Juice Hut', 'Bubble Tea N Cotton Candy', 'Coffee N Candy']
        && request.resource.data.shopName == store;
    }
    match /dailySpends/{date}/spends/{id} {
      allow read, write: if admin();
    }
    match /inventory/{store}/items/{id} {
      allow read, write: if admin();
    }
  }
}
